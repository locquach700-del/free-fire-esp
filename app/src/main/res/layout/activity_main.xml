<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0D0D1A">

    <!-- Logo / Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FF ESP"
        android:textSize="48sp"
        android:textColor="#FF4444"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OB55 | by Noob"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginBottom="48dp"/>

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● ESP TẮT"
        android:textSize="18sp"
        android:textColor="#FF4444"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <!-- Feature list -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A2E"
        android:padding="20dp"
        android:layout_marginBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓  ESP Box (hộp đỏ quanh địch)"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓  Snapline (tia vàng đến địch)"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓  HP Bar + khoảng cách"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓  Nút toggle kéo được"
            android:textColor="#CCCCCC"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- START button -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="▶  MỞ FREE FIRE + BẬT ESP"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#CC2222"
        android:layout_marginBottom="16dp"/>

    <!-- STOP button -->
    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="■  TẮT ESP"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:backgroundTint="#333355"
        android:enabled="false"/>

    <!-- Note -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lần đầu: cần cấp quyền Overlay"
        android:textSize="12sp"
        android:textColor="#555555"
        android:layout_marginTop="24dp"/>

</LinearLayout>
